---
import Layout from '../layouts/Layout.astro';
import site from '../data/site';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TyreFinder from '../components/TyreFinder.astro';
import Reviews from '../components/Reviews.astro';
import Process from '../components/Process.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Benefits from '../components/Benefits.astro';
import FAQ from '../components/FAQ.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';

const phoneTarget = site.contact.phoneHref || '#contact';
---

<Layout>
  <Header />
  <main id="main-content">
    <Hero />
    <TyreFinder />
    <Reviews />
    <Process />
    <Services />
    <Gallery />
    <Benefits />
    <FAQ />
    <Contact />
  </main>
  <Footer />
  <div class="mobile-sticky-call">
    <a class="mobile-bar-primary" href="#devis"><span>Vérifier mon prix</span><span class="mobile-bar-arrow" aria-hidden="true">↗</span></a>
    <a class="mobile-bar-call" href={phoneTarget} aria-label={`Appeler AutoBac66 au ${site.contact.phoneDisplay}`}><span class="mobile-bar-icon" aria-hidden="true">☎</span><span class="mobile-bar-number">{site.contact.phoneDisplay}</span></a>
  </div>
</Layout>
