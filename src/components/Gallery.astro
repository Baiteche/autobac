---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import site from '../data/site';
import atelierPontLift from '../assets/images/atelier-pont-lift.jpg';
import atelierVoiturePont from '../assets/images/atelier-voiture-pont.jpg';
import atelierEtabliOutils from '../assets/images/atelier-etabli-outils.jpg';
import atelierTravauxMecanique from '../assets/images/atelier-travaux-mecanique.jpg';
import stockMurPneus from '../assets/images/stock-mur-pneus.jpg';
import pneuJanteControle from '../assets/images/pneu-jante-controle.jpg';

const photosById: Record<string, ImageMetadata> = {
  'atelier-pont-lift': atelierPontLift,
  'atelier-voiture-pont': atelierVoiturePont,
  'atelier-etabli-outils': atelierEtabliOutils,
  'atelier-travaux-mecanique': atelierTravauxMecanique,
  'stock-mur-pneus': stockMurPneus,
  'pneu-jante-controle': pneuJanteControle
};

const photos = site.gallery.photos.map((photo, index) => ({
  ...photo,
  index: String(index + 1).padStart(2, '0'),
  image: photosById[photo.id]
}));
---

<section class="gallery-section" id="atelier" aria-labelledby="gallery-title">
  <div class="container">
    <div class="section-heading split-heading gallery-heading">
      <div><p class="eyebrow eyebrow-light"><span class="eyebrow-dot"></span> Dans l’atelier</p><h2 id="gallery-title">Le garage,<br /><em>en images.</em></h2></div>
      <p>Montage, équilibrage, contrôle avant montage : voici le type de travail et le cadre d’un atelier pneus comme le nôtre, au 44 boulevard Frédéric Mistral.</p>
    </div>
    <div class="gallery-grid">
      {photos.map((photo, index) => (
        <figure class={`gallery-item gallery-item-${index === 0 ? 'lead' : 'std'}`}>
          <div class="gallery-media">
            <Image
              src={photo.image}
              alt={photo.alt}
              widths={[440, 720, 1040]}
              sizes="(max-width: 720px) 92vw, (max-width: 1080px) 46vw, 33vw"
              format="webp"
              quality={72}
              loading="lazy"
              decoding="async"
            />
          </div>
          <figcaption><span class="gallery-index" aria-hidden="true">{photo.index}</span><span>{photo.caption}</span></figcaption>
        </figure>
      ))}
    </div>
    <p class="gallery-note"><span aria-hidden="true">↳</span> {site.gallery.note}</p>
  </div>
</section>
