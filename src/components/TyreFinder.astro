---
import site from '../data/site';

const phoneTarget = site.contact.phoneHref || '#contact';
const mapTarget = site.address.mapsUrl;
const thanksUrl = new URL('thanks/', Astro.site).href;
---

<section class="finder-section" id="devis" aria-labelledby="finder-title">
  <div class="container finder-layout">
    <div class="finder-intro">
      <p class="eyebrow"><span class="eyebrow-dot"></span> Vérification immédiate à Perpignan</p>
      <h2 id="finder-title">Vos pneus en stock<br /><em>au meilleur prix ?</em></h2>
      <p>Indiquez vos dimensions : nous vérifions directement notre stock (<strong>occasions contrôlées</strong> &amp; <strong>pneus neufs</strong>) et nous vous confirmons le prix et la disponibilité.</p>
      
      <!-- Les 3 options de contact direct -->
      <div class="finder-alternatives" aria-label="Autres moyens de contact rapide">
        <div class="finder-alt-badge">3 façons d’obtenir votre tarif :</div>
        <div class="finder-alt-grid">
          <a class="finder-alt-item finder-alt-call" href={phoneTarget}>
            <span class="finder-alt-icon" aria-hidden="true">📞</span>
            <div>
              <strong>Appeler l'atelier</strong>
              <span>Appel direct · {site.contact.hours}</span>
            </div>
            <span class="button-arrow" aria-hidden="true">↗</span>
          </a>
          <a class="finder-alt-item finder-alt-gps" href={mapTarget} target="_blank" rel="noreferrer">
            <span class="finder-alt-icon" aria-hidden="true">📍</span>
            <div>
              <strong>Venir sans RDV</strong>
              <span>{site.contact.walkIn} · {site.contact.hours}</span>
            </div>
            <span class="button-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <div class="finder-note"><span aria-hidden="true">↳</span> Exemple relevé sur votre flanc de pneu : <strong>205 / 55 / R16</strong></div>
    </div>
    <div class="finder-card">
      <div class="finder-card-head">
        <span>VÉRIFICATION DE STOCK &amp; PRIX</span>
        <span class="finder-status"><i></i> Réponse rapide 66</span>
      </div>

      <form data-tyre-form action={site.leadCapture.endpoint} method="POST">
        <!-- Champs Formspree : utiles si le JavaScript est désactivé (l'envoi normal reste en AJAX). -->
        <input type="hidden" name="_subject" value={`Nouvelle demande pneus — ${site.displayName}`} />
        <input type="hidden" name="_next" value={thanksUrl} />
        <!-- Dimensions -->
        <div class="size-fields">
          <label><span>Largeur</span><input name="width" inputmode="numeric" pattern="[0-9]{3}" maxlength="3" placeholder="205" required /></label>
          <span class="slash" aria-hidden="true">/</span>
          <label><span>Hauteur</span><input name="height" inputmode="numeric" pattern="[0-9]{2}" maxlength="2" placeholder="55" required /></label>
          <span class="slash" aria-hidden="true">R</span>
          <label><span>Diamètre</span><input name="diameter" inputmode="numeric" pattern="[0-9]{2}" maxlength="2" placeholder="16" required /></label>
        </div>

        <!-- Quantité -->
        <fieldset class="condition-field">
          <legend>Quantité souhaitée</legend>
          <div class="choice-grid choice-grid-qty">
            <label class="choice"><input type="radio" name="quantity" value="2 pneus" checked /><span>2 pneus</span></label>
            <label class="choice"><input type="radio" name="quantity" value="4 pneus" /><span>4 pneus</span></label>
            <label class="choice"><input type="radio" name="quantity" value="1 pneu" /><span>1 pneu</span></label>
          </div>
        </fieldset>

        <!-- État / Préférence -->
        <fieldset class="condition-field">
          <legend>Votre priorité</legend>
          <div class="choice-grid">
            <label class="choice"><input type="radio" name="condition" value="occasion (priorité prix)" checked /><span>Occasion vérifiée</span></label>
            <label class="choice"><input type="radio" name="condition" value="neufs" /><span>Pneus neufs</span></label>
            <label class="choice"><input type="radio" name="condition" value="le moins cher (neuf ou occasion)" /><span>Le - cher</span></label>
          </div>
        </fieldset>

        <!-- Offre du moment -->
        <fieldset class="condition-field offer-field">
          <legend>Offre du moment · 2 pneus achetés</legend>
          <label class="consent-choice">
            <input type="checkbox" name="offre_parallelisme" value="Oui — parallélisme à 50 € au lieu de 80 €" />
            <span>Ajouter le parallélisme à <strong>50 €</strong> au lieu de <strong>80 €</strong></span>
          </label>
          <p class="offer-note">{site.promotion.conditions}</p>
        </fieldset>

        <!-- Téléphone -->
        <div class="finder-contact-field">
          <label for="tyre-phone"><span>Numéro de mobile (pour recevoir prix &amp; dispo)</span><input id="tyre-phone" name="phone" type="tel" inputmode="tel" autocomplete="tel" pattern="[0-9+() .-]{8,}" placeholder="06 12 34 56 78" required /></label>
          <p>Uniquement pour répondre à cette demande de pneu.</p>
        </div>

        <input type="hidden" name="_subject" value="Demande pneus & prix — AutoBac66 Perpignan" />
        <input type="hidden" name="source" value="Formulaire pneus AutoBac66" />
        <input class="honeypot" type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" />
        
        <button class="button button-primary finder-submit" type="submit">
          <span>Vérifier le stock &amp; recevoir le prix</span>
          <span class="button-arrow" aria-hidden="true">↗</span>
        </button>

        <p class="finder-guarantee">✓ Montage &amp; équilibrage sur place · Avec ou sans rendez-vous, du lundi au samedi</p>
      </form>
      <!-- Écran de confirmation après envoi -->
      <div class="finder-result" data-finder-result hidden aria-live="polite">
        <div class="result-check" aria-hidden="true">✓</div>
        <div class="result-content">
          <strong>Demande bien transmise à l’atelier !</strong>
          <p class="result-recap" data-message></p>
          <p class="result-instruction">Nous vérifions notre stock au 44 bd Frédéric Mistral et nous vous répondons au numéro indiqué. Pour une réponse immédiate, appelez le {site.contact.phoneDisplay}.</p>
          
          <div class="result-actions-block">
            <span class="result-actions-title">Besoin d’une réponse immédiate ?</span>
            <div class="result-actions">
              <a class="button button-primary button-small" href={phoneTarget} data-result-call>
                <span>Appeler le {site.contact.phoneDisplay}</span><span class="button-arrow" aria-hidden="true">↗</span>
              </a>
              <a class="button button-outline-light button-small" href={mapTarget} target="_blank" rel="noreferrer">
                <span>Itinéraire GPS</span><span class="button-arrow" aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <p class="finder-error" data-finder-error role="alert" hidden>
        La demande n’a pas pu aboutir. N’hésitez pas à nous appeler directement au garage.
      </p>
      <p class="finder-footnote">AutoBac66 · {site.address.street}, {site.city} · {site.contact.hours} · {site.contact.phoneDisplay}</p>
    </div>
  </div>
</section>

<script>
  const form = document.querySelector('[data-tyre-form]');
  const result = document.querySelector('[data-finder-result]');
  const message = document.querySelector('[data-message]');
  const callLink = document.querySelector('[data-result-call]');
  const errorMessage = document.querySelector('[data-finder-error]');
  const submitButton = form?.querySelector('button[type="submit"]');
  const submitLabel = submitButton?.querySelector('span:first-child');

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const data = new FormData(form);
    const width = String(data.get('width') || '').trim();
    const height = String(data.get('height') || '').trim();
    const diameter = String(data.get('diameter') || '').trim();
    const quantity = String(data.get('quantity') || '2 pneus');
    const condition = String(data.get('condition') || 'occasion');
    const offer = data.get('offre_parallelisme') ? 'Oui — parallélisme à 50 € au lieu de 80 €' : '';
    const phone = String(data.get('phone') || '').trim();
    
    if (!width || !height || !diameter || !phone || data.get('_gotcha')) return;

    data.set('demande_recap', `${quantity} | ${width}/${height} R${diameter} | ${condition}${offer ? ` | Offre parallélisme : ${offer}` : ''}`);

    submitButton?.setAttribute('disabled', 'true');
    if (submitLabel) submitLabel.textContent = 'Vérification en cours…';
    errorMessage?.setAttribute('hidden', 'true');

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: data,
        headers: { Accept: 'application/json' }
      });
      if (!response.ok) throw new Error('Form submission failed');

      const recapText = `Recherche de : ${quantity} × ${width}/${height} R${diameter} (${condition}).${offer ? ' Offre parallélisme à 50 € demandée.' : ''} Réponse au ${phone}.`;
      if (message) message.textContent = recapText;
      result?.removeAttribute('hidden');
      form.setAttribute('hidden', 'true');
      result?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      if (callLink) callLink.setAttribute('aria-label', `Appeler AutoBac66 au sujet de la demande ${width}/${height} R${diameter}`);
    } catch {
      errorMessage?.removeAttribute('hidden');
      submitButton?.removeAttribute('disabled');
      if (submitLabel) submitLabel.textContent = 'Réessayer';
    }
  });
</script>
