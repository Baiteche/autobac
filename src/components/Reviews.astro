---
import site from '../data/site';

// Cinq citations suffisent à installer la preuve : les cinq avis les plus
// récents (l'ordre de site.reviews suit la chronologie Google).
const visibleReviews = site.reviews.slice(0, 5);
---

{site.reviews.length > 0 && <section class="reviews-section section-light" id="avis" aria-labelledby="reviews-title">
  <div class="container">
    <div class="section-heading split-heading reviews-heading">
      <div><p class="eyebrow"><span class="eyebrow-dot"></span> Avis Google</p><h2 id="reviews-title">À vous de<br /><em>nous le dire.</em></h2></div>
      <p>Ce que retiennent les automobilistes du secteur : un conseil direct, un devis annoncé avant les travaux et un montage réalisé sur place.</p>
    </div>
    <div class="reviews-grid">
      {visibleReviews.map((review) => (
        <article class="review-card">
          <p class="review-stars">
            <span class="sr-only">Note : {review.rating} sur 5</span>
            <span aria-hidden="true">{'★'.repeat(review.rating)}{'☆'.repeat(5 - review.rating)}</span>
          </p>
          <blockquote class="review-quote"><p>“{review.text}”</p></blockquote>
          <footer class="review-meta">
            <span class="review-avatar" aria-hidden="true">{review.name.charAt(0)}</span>
            <span class="review-author">{review.name}</span>
            <span class="review-date">{review.date}</span>
          </footer>
        </article>
      ))}
    </div>
    <p class="reviews-note">
      <span aria-hidden="true">↳</span> Les cinq avis les plus récents publiés par les clients d’AutoBac66 sur Google. <a href={site.reviewsUrl} target="_blank" rel="noreferrer">Tous les avis sur la fiche Google</a>
    </p>
  </div>
</section>}

